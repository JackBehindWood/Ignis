"""
Example pre-build hook. Runs before compilation starts.

To use: copy to pre_build.py and customize the run() function.

The `ctx` parameter provides:
  - ctx.config: Config singleton (access paths, settings)
  - ctx.configuration: current build config (Debug/Release/Distribution)
  - ctx.project_dir: project root
  - ctx.bin_dir: output directory (bin/)
  - ctx.obj_dir: intermediate directory (bin-int/)
  - ctx.verbose: verbose flag
"""


def run(ctx):
    """Called before build_project(). Exit with error code to fail the build."""
    import os

    print(f"Pre-build hook for {ctx.configuration} config")

    # Example: Generate version header
    version_header = os.path.join(ctx.project_dir, "engine", "src", "version.h")
