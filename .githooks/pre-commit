#!/bin/bash
# Pre-commit hook: check code formatting with clang-format and lint with clang-tidy

set -e

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp|c)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check formatting with clang-format
if command -v clang-format &> /dev/null; then
    echo "Checking code formatting with clang-format..."
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            clang-format --dry-run -Werror "$file" || {
                echo "❌ $file has formatting issues. Run: clang-format -i $file"
                exit 1
            }
        fi
    done
    echo "✓ Code formatting check passed"
else
    echo "⚠ clang-format not found, skipping format check"
fi

# Lint with clang-tidy (optional)
if command -v clang-tidy &> /dev/null; then
    echo "Running clang-tidy..."
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            clang-tidy "$file" -- -Iengine/src -std=c++20 || {
                echo "⚠ clang-tidy found issues in $file (non-blocking)"
            }
        fi
    done
    echo "✓ Linting check completed"
fi

exit 0
