#!/usr/bin/env bash
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cpp|h|hpp|mm)$' || true)
[ -z "$STAGED" ] && exit 0

if ! command -v clang-format &>/dev/null; then
    echo "pre-commit: clang-format not found — skipping (brew install clang-format)"
    exit 0
fi

CHANGED=()
while IFS= read -r file; do
    [ -f "$file" ] || continue
    # Format the staged blob, not the on-disk file — avoids staging unstaged edits
    staged=$(git show ":$file")
    formatted=$(printf '%s\n' "$staged" | clang-format --assume-filename="$file")
    if [ "$staged" != "$formatted" ]; then
        printf '%s\n' "$formatted" > "$file"
        git add "$file"
        CHANGED+=("$file")
    fi
done <<< "$STAGED"

if [ ${#CHANGED[@]} -gt 0 ]; then
    echo "pre-commit: auto-formatted ${#CHANGED[@]} file(s):"
    printf '  %s\n' "${CHANGED[@]}"
fi
